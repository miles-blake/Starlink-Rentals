# Copy to .env for local development. Never commit the real .env file.
# See starlink-rental-blueprint.md section 14 for the full reference.

# --- Phase 0: Foundation ---

# Postgres connection string (Neon, Supabase, or any Postgres host).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js / NextAuth.
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Used once by `npx prisma db seed` to create the first admin user, and
# (with BASE_ADDRESS below) the Setting row. Not read by the running app —
# safe to unset after seeding.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Phase 1: Eligibility and quote engine ---

# Server-only key for Places API (New) and the Routes API. Used by
# /api/places/autocomplete, /api/eligibility, and the seed script — never
# sent to the browser. Address autocomplete is proxied through our own API
# route instead of Google's client-side widget, so there is no separate
# browser key to manage or restrict by referrer.
GOOGLE_MAPS_SERVER_KEY=""

# Seed-only: your base address, geocoded once by `npx prisma db seed` into
# Setting.baseLat/baseLng. Not read by the running app.
BASE_ADDRESS=""

# --- Phase 2: Availability and reservations ---

# Authenticates Vercel Cron's calls to /api/cron/expire-holds. Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# --- Phase 3: Rental agreement e-sign ---

# Transactional email (signed-agreement PDF delivery, and later phases).
# Sandbox accounts can only send to the account's own signup address until
# a sending domain is verified in the Resend dashboard.
RESEND_API_KEY=""
FROM_EMAIL="Starlink Rentals <onboarding@resend.dev>"

# Stores the generated signed-agreement PDFs (private access). Also reused
# in Phase 6 for condition photos. Get the real value from the Blob store's
# own "Quickstart" tab in the Vercel dashboard, not `vercel env pull` — tokens
# marked Sensitive never appear there.
BLOB_READ_WRITE_TOKEN=""

# --- Phase 6: Communication, photos, notifications ---

# Admin push notifications (Web Push from the installed admin PWA — no
# third-party push service). Self-generated, not an external account:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is bundled into the browser deliberately
# (that's what "public" means for VAPID) — do not do the same with the
# private key.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Condition photos reuse BLOB_READ_WRITE_TOKEN from Phase 3 above — nothing
# new to set here.
#
# Not implemented in this build (a deliberate scope decision, not an
# oversight): Twilio SMS (renter-facing and the critical-event admin
# fallback) and the Pushover/ntfy admin push channels the blueprint lists as
# options — the operator chose Web Push as the only admin channel and
# email-only for renters. Add Twilio here (TWILIO_ACCOUNT_SID,
# TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER) if that changes.

# --- Phase 7: Hardening (optional) ---

SENTRY_DSN=""
