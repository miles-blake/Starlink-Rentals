# Copy to .env for local development. Never commit the real .env file.
# See starlink-rental-blueprint.md section 14 for the full reference.

# --- Phase 0: Foundation ---

# Postgres connection string (Neon, Supabase, or any Postgres host).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js / NextAuth.
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Used once by `npx prisma db seed` to create the first admin user.
# Not read by the running app — safe to unset after seeding.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Phase 1: Eligibility and quote engine ---

# Server-only key for Geocoding / Distance Matrix. Never expose to the browser.
GOOGLE_MAPS_SERVER_KEY=""
# Referrer-restricted key for the Places Autocomplete widget in the browser.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""

# --- Phase 3/6: Transactional email ---

RESEND_API_KEY=""
FROM_EMAIL=""

# --- Phase 6: Communication, photos, notifications ---

# Optional: renter-facing SMS and the critical-event SMS fallback.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Admin push — pick one provider.
PUSHOVER_TOKEN=""
PUSHOVER_USER_KEY=""
# NTFY_TOPIC=""
# NTFY_SERVER=""

# Optional: native Web Push from the installed admin PWA.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Condition photo storage (Vercel Blob shown; Supabase Storage keys work too).
BLOB_READ_WRITE_TOKEN=""

# --- Phase 7: Hardening (optional) ---

SENTRY_DSN=""
